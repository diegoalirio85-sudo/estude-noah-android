# Copie para .env somente em desenvolvimento local.
# Nunca versione .env, chaves Gemini ou credenciais do Google Cloud.
PORT=8080
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
APP_CHECK_ENABLED=true
FIREBASE_PROJECT_NUMBER=
FIREBASE_APP_IDS=
RATE_LIMIT_REQUESTS_PER_MINUTE=30
MAX_JSON_BYTES=1048576
MAX_UPLOAD_BYTES=53477376

