# Copie para .env somente em desenvolvimento local.
# Nunca versione .env, chaves Gemini ou credenciais do Google Cloud.
PORT=8080
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
BACKEND_AUTH_MODE=firebase_auth
ALLOW_AUTH_NONE=false
FIREBASE_PROJECT_ID=
ALLOWED_FIREBASE_UIDS=
APP_CHECK_ENABLED=true
FIREBASE_PROJECT_NUMBER=
FIREBASE_APP_IDS=
RATE_LIMIT_REQUESTS_PER_MINUTE=30
MAX_JSON_BYTES=1048576
MAX_UPLOAD_BYTES=53477376
MATERIAL_URL_ALLOWED_HOSTS=brasilescola.uol.com.br,*.jesuitasbrasil.org.br

# No modo privado atual, preencha FIREBASE_PROJECT_ID e ALLOWED_FIREBASE_UIDS.
# ALLOW_AUTH_NONE deve permanecer false fora de testes isolados.
# MATERIAL_URL_ALLOWED_HOSTS limita quais páginas públicas o backend pode abrir
# para localizar um destino YouTube. Não use curingas amplos como *.com.
# APP_CHECK_ENABLED/FIREBASE_PROJECT_NUMBER/FIREBASE_APP_IDS são usados apenas
# se BACKEND_AUTH_MODE=app_check for adotado explicitamente em outro ambiente.
